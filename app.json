{
  "expo": {
    "name": "ConTrack",
    "slug": "Con_Track",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F2654",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ots.manager"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2654"
      },
      "package": "com.ots.manager"
    }
  }
}
